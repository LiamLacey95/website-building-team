{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/impeccable-hook.mjs\"",
            "timeout": 12,
            "statusMessage": "Impeccable: checking site edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/tools/impeccable-hook.mjs\"",
            "timeout": 60,
            "statusMessage": "Impeccable: design deep pass"
          }
        ]
      }
    ]
  }
}
