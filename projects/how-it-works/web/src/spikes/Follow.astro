---
/**
 * Direction C (marble on the track). Two techniques side by side:
 *  1. Pure CSS: offset-path + offset-distance on a scroll timeline. 0 KB JS, but path() coordinates are
 *     absolute px, so the track is drawn in a fixed-size box scaled with container units.
 *  2. JS: getPointAtLength() mapped to scroll progress, writing two CSS custom properties per frame
 *     (CSSOM, allowed under the CSP). Responsive by construction; ~0.6 KB.
 */
---
<p>Scroll: both marbles roll along the same track. Left is pure CSS, right is a few lines of JS.</p>
<div class="spacer" aria-hidden="true"></div>
<div class="pair">
  <div class="stage css" aria-hidden="true">
    <svg viewBox="0 0 400 400"><path class="rail" d="M40 20 C 360 60, 360 160, 200 200 S 40 340, 360 380" /></svg>
    <div class="space"><span class="marble"></span></div>
  </div>
  <div class="stage js" aria-hidden="true" data-follow>
    <svg viewBox="0 0 400 400"><path class="rail" d="M40 20 C 360 60, 360 160, 200 200 S 40 340, 360 380" /></svg>
    <span class="marble"></span>
  </div>
</div>
<div class="spacer" aria-hidden="true"></div>

<script>
  const stage = document.querySelector<HTMLElement>('[data-follow]');
  const path = stage?.querySelector<SVGPathElement>('path');
  const marble = stage?.querySelector<HTMLElement>('.marble');
  const motionOff = () =>
    document.documentElement.dataset.motion === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stage && path && marble) {
    const len = path.getTotalLength();
    let queued = false;
    const place = () => {
      queued = false;
      const r = stage.getBoundingClientRect();
      const t = motionOff() ? 1 : Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
      const p = path.getPointAtLength(t * len);
      const s = r.width / 400;
      marble.style.setProperty('--x', `${p.x * s}px`);
      marble.style.setProperty('--y', `${p.y * s}px`);
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(place); } }, { passive: true });
    addEventListener('resize', place);
    place();
  }
</script>

<style>
  .spacer { height: 70vh; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-l); }
  .stage { position: relative; aspect-ratio: 1; container-type: inline-size; }
  .stage svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rail { fill: none; stroke: var(--color-line); stroke-width: 10; stroke-linecap: round; }
  .marble {
    position: absolute; left: 0; top: 0; width: 28px; height: 28px; margin: -14px 0 0 -14px;
    border-radius: 50%; background: var(--color-accent);
  }
  /* path() is in px: the marble moves in a fixed 400px box that is scaled to the stage (container units). */
  .css { view-timeline-name: --track; }
  .css .space { position: absolute; left: 0; top: 0; width: 400px; height: 400px; transform-origin: 0 0; scale: calc(100cqi / 400px); }
  .css .marble {
    width: calc(28px * 400px / 100cqi); height: calc(28px * 400px / 100cqi); margin: 0;
    offset-path: path('M40 20 C 360 60, 360 160, 200 200 S 40 340, 360 380');
    offset-distance: 100%;
    offset-rotate: 0deg;
    offset-anchor: center;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(:root:not([data-motion='off'])) .css .marble {
        animation-name: roll;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --track;
        animation-range-start: entry 0%;
        animation-range-end: exit 100%;
      }
    }
  }
  @keyframes roll { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  .js .marble { translate: var(--x, 0) var(--y, 0); }
</style>
