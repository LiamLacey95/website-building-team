---
/**
 * Master home: the baseline composition of the shared Marble Run components (a plain linear read).
 * Each Gate 3 variation replaces this file with its own structure and set piece.
 */
import Base from '../layouts/Base.astro';
import SetupSentence from '../components/SetupSentence.astro';
import ChapterText from '../components/ChapterText.astro';
import LevelCrossing from '../components/LevelCrossing.astro';
import WearTheOthers from '../components/WearTheOthers.astro';
import Art from '../components/Art.astro';
import { getChapters, getSite } from '../lib/content';
import { CHAPTER_ART } from '../lib/images';

const site = await getSite();
const chapters = await getChapters();
const story = chapters.filter((c) => c.data.order > 0);
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 id="hero-title">{site.heroLine}</h1>
      <SetupSentence sentence={site.setupSentence} label={site.setupIntro} notice={site.gpuNotice} id="hero-setup" />
      <p class="hero__next">{site.whatHappensNext}</p>
    </div>
    <Art name="hero" eager sizes="(min-width: 60rem) 58vw, 100vw" class="hero__art" />
  </section>

  {story.map((c) => {
    const art = CHAPTER_ART[c.data.slug];
    return (
      <section class="station" id={c.data.slug} aria-label={c.data.title}>
        <div class="station__grid">
          <ChapterText entry={c} />
          {art && <Art name={art} class="station__art" />}
        </div>
        {c.data.gate === 'G2' && <WearTheOthers />}
        {c.data.gate && <LevelCrossing gate={c.data.gate} />}
        {c.data.order === 9 && (
          <SetupSentence sentence={site.setupSentence} label={site.setupIntro} notice={site.gpuNotice} id="end-setup" />
        )}
      </section>
    );
  })}
</Base>

<style>
  .hero, .station { max-width: 1240px; margin-inline: auto; padding-inline: var(--gutter); }
  .hero {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-6);
    align-items: center; padding-block: var(--space-6) var(--space-8);
  }
  .hero__copy { display: grid; gap: var(--space-5); }
  .hero__next { font-weight: 700; }
  .station { display: grid; gap: var(--space-6); padding-block: var(--space-7); }
  .station__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-6); align-items: start; }
  .station__art { position: sticky; top: var(--space-5); }
  @media (max-width: 60rem) {
    .hero, .station__grid { grid-template-columns: 1fr; }
    .station__art { position: static; }
  }
</style>
