---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const credits = (await getEntry('credits', 'main'))?.data;
if (!credits) throw new Error('credits: entry "main" missing');
---
<Base title="Credits and licences">
  <h1>Credits and licences</h1>

  <section id="licences" aria-labelledby="licences-title">
    <h2 id="licences-title">Licences</h2>
    <ul class="licences">
      {credits.licences.map((l) => (
        <li>
          <h3><a href={l.url}>{l.name}</a></h3>
          <p>{l.what}. <strong>{l.licence}</strong>{l.note && `. ${l.note}`}</p>
        </li>
      ))}
    </ul>
    <p>{credits.diamondCredit}</p>
  </section>

  <section id="ai-imagery" aria-labelledby="ai-imagery-title">
    <h2 id="ai-imagery-title">AI-generated imagery</h2>
    <p>{credits.aiDisclosure}</p>
  </section>

  <section id="privacy" aria-labelledby="privacy-title">
    <h2 id="privacy-title">Privacy</h2>
    <p>{credits.privacy}</p>
  </section>

  <section id="accessibility" aria-labelledby="accessibility-title">
    <h2 id="accessibility-title">Accessibility</h2>
    <p>{credits.accessibility}</p>
  </section>
</Base>

<style>
  h1 { margin-block-end: var(--space-l); }
  section { display: grid; gap: var(--space-s); padding-block: var(--space-l); border-top: 1px solid var(--color-line); }
  .licences { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-m); }
  .licences h3 { font-size: var(--step-1); }
</style>
