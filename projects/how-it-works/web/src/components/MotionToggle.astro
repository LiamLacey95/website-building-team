---
/**
 * "Reduce motion" toggle. Hidden without JS (CSS still honours the OS setting). site.ts flips
 * data-motion="off" on <html> and persists the choice, a preference the visitor asked for, in localStorage.
 */
---
<button type="button" class="motion-toggle" aria-pressed="false" data-motion-toggle data-js-only>
  Reduce motion
</button>

<style>
  .motion-toggle {
    font: inherit;
    font-size: var(--step--1);
    min-height: 44px;
    padding: var(--space-3xs) var(--space-s);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }
  .motion-toggle[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
</style>
