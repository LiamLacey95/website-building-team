---
/**
 * "Reduce motion" toggle. Hidden without JS (CSS still honours the OS setting). site.ts flips
 * data-motion="off" on <html> and persists the choice, a preference the visitor asked for, in localStorage.
 */
---
<button type="button" class="btn motion-toggle" aria-pressed="false" data-motion-toggle data-js-only>
  Reduce motion
</button>

<style>
  .motion-toggle { min-height: 40px; padding: var(--space-2) var(--space-4); font-size: var(--fs-sm); }
</style>
