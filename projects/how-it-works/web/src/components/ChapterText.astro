---
/**
 * The reading part of a chapter (contract: chapters): title, dek, narrative, scenes and artefacts, on a white
 * card. Variations decide where it sits (beside the run, inside a station, behind a zoom); this stays the same.
 */
import { render, type CollectionEntry } from 'astro:content';
import Artefact from './Artefact.astro';
import Scene from './Scene.astro';

interface Props {
  entry: CollectionEntry<'chapters'>;
  /** Show artefacts and scenes (default) or only the text. */
  full?: boolean;
}
const { entry, full = true } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<article class="chapter-text" aria-labelledby={`${d.slug}-title`}>
  <div class="chapter-text__card card">
    <h2 id={`${d.slug}-title`}>{d.title}</h2>
    <p class="chapter-text__dek">{d.dek}</p>
    <div class="chapter-text__body"><Content /></div>
  </div>
  {full && d.scenes.map((id) => <Scene id={id} />)}
  {full && d.artefacts.map((a) => <Artefact artefact={a} diamond={d.diamond} />)}
</article>

<style>
  .chapter-text { display: grid; gap: var(--space-5); }
  .chapter-text__card { display: grid; gap: var(--space-4); padding: var(--space-6); }
  .chapter-text__dek { font: 800 var(--fs-1) / 1.3 var(--font-display); font-variation-settings: 'opsz' 36, 'wdth' 90; }
  .chapter-text__body { display: grid; gap: var(--space-3); }
  .chapter-text__body :global(strong) { font-weight: 800; }
  @media (max-width: 40rem) { .chapter-text__card { padding: var(--space-5); } }
</style>
