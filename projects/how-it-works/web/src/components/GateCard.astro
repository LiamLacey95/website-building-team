---
/** The gate card (contract: gates). What the human saw, the options, the choice, and the revise loop-back. */
import { getEntry } from 'astro:content';

interface Props {
  gate: 'G1' | 'G2' | 'G3' | 'G4';
}
const entry = await getEntry('gates', Astro.props.gate);
if (!entry) throw new Error(`gates: no entry ${Astro.props.gate}`);
const g = entry.data;
---
<aside class="gate" aria-labelledby={`gate-${entry.id}`}>
  <h3 id={`gate-${entry.id}`}>Gate {g.number}: {g.name}</h3>
  <p class="question">{g.question}</p>
  <div class="cols">
    <div>
      <h4>What the human sees</h4>
      <ul>{g.packet.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div>
      <h4>The options</h4>
      <ul class="options">
        {g.options.map((o) => <li><strong>{o.letter}. {o.label}.</strong> {o.detail}</li>)}
      </ul>
    </div>
  </div>
  <p class="decision"><strong>Decision: {g.decision.choice}.</strong> “{g.decision.quote}” {g.decision.consequence}</p>
  <p class="revise">If it had been “revise”: “{g.revise.quote}” {g.revise.outcome}</p>
</aside>

<style>
  .gate { display: grid; gap: var(--space-s); padding: var(--space-m); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-l); }
  h3 { font-size: var(--step-2); }
  h4 { font-size: var(--step-0); margin: 0 0 var(--space-3xs); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-m); }
  ul { margin: 0; padding-inline-start: var(--space-m); }
  .revise { color: var(--color-ink-muted); }
</style>
