---
/**
 * The double diamond with the four gates (static). The Gate 3 directions animate it; the scaffold only
 * draws it. Credit: Double Diamond by the Design Council, CC BY 4.0, adapted (shown on /credits/).
 */
interface Props {
  current?: 'd1-diverge' | 'd1-converge' | 'd2-diverge' | 'd2-converge' | null;
}
const { current = null } = Astro.props;
const segments = {
  'd1-diverge': 'M20 150 L260 30 M20 150 L260 270',
  'd1-converge': 'M260 30 L500 150 M260 270 L500 150',
  'd2-diverge': 'M500 150 L740 30 M500 150 L740 270',
  'd2-converge': 'M740 30 L980 150 M740 270 L980 150',
} as const;
const gates = [
  { id: 'G1', x: 500, y: 150 },
  { id: 'G2', x: 640, y: 80 },
  { id: 'G3', x: 840, y: 80 },
  { id: 'G4', x: 980, y: 150 },
];
---
<svg class="diamond" viewBox="-10 0 1020 300" role="img" aria-labelledby="dd-title">
  <title id="dd-title">The double diamond. Discover and Define end at Gate 1; Develop holds Gates 2 and 3; Deliver ends at Gate 4.</title>
  <path class="diamond__track" d="M20 150 L260 30 L500 150 L260 270 Z M500 150 L740 30 L980 150 L740 270 Z" />
  {current && <path class="diamond__current" d={segments[current]} />}
  {gates.map((g) => (
    <g class="diamond__gate">
      <circle cx={g.x} cy={g.y} r="12" />
      <text x={g.x} y={g.y - 22} text-anchor="middle">{g.id}</text>
    </g>
  ))}
</svg>

<style>
  .diamond { width: 100%; max-width: 48rem; }
  .diamond__track { fill: none; stroke: var(--color-line); stroke-width: 3; stroke-linejoin: round; }
  .diamond__current { fill: none; stroke: var(--color-ink); stroke-width: 5; stroke-linecap: round; }
  .diamond__gate circle { fill: var(--color-surface); stroke: var(--color-ink); stroke-width: 3; }
  .diamond__gate text { fill: var(--color-ink); font: 600 22px var(--font-body); }
</style>
