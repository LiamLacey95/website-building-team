---
/**
 * A content slot (contract: `slots`). Filled: responsive AVIF/WebP via <Picture> with the master's intrinsic
 * size (CLS 0). Pending: a designed placeholder, a sky "not yet built" bay on the track that names its gate.
 */
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';

interface Props {
  slot: string;
  caption: string;
}
const { slot, caption } = Astro.props;
const entry = await getEntry('slots', slot);
const data = entry?.data;
---
{data?.status === 'filled' ? (
  <figure class="slot photo">
    {data.items.map((item) => (
      <Picture
        src={item.src}
        alt={item.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[400, 800, 1200, 1600]}
        sizes="(min-width: 80rem) 60rem, 100vw"
        loading="lazy"
      />
    ))}
    <figcaption class="slot__cap">{caption}{data.items[0]?.caption && `. ${data.items[0].caption}`}</figcaption>
  </figure>
) : (
  <figure class="slot slot--pending">
    <span class="marble slot__marble" aria-hidden="true"></span>
    <p class="slot__label">{data?.pendingLabel ?? 'This happens at a later gate.'}</p>
    <figcaption class="slot__cap">{caption}</figcaption>
  </figure>
)}

<style>
  .slot { margin: 0; display: grid; gap: var(--space-3); }
  .slot__cap { font-size: var(--fs-sm); font-weight: 700; }
  .slot--pending {
    justify-items: center; text-align: center; padding: var(--space-6) var(--space-5);
    background: var(--c-bg-2); color: var(--c-text);
    border: var(--border); border-style: dashed; border-radius: var(--radius-lg);
  }
  .slot__marble { font-size: 2rem; }
  .slot__label { font: 800 var(--fs-1) / 1.2 var(--font-display); font-variation-settings: 'opsz' 36, 'wdth' 90; }
</style>
