---
/** A scene (contract: scenes): a short exchange written for the story (G1 Q5). Rendered as a plain log until Gate 3. */
import { getEntry } from 'astro:content';
import { roleName } from '../lib/content';

interface Props {
  id: string;
}
const entry = await getEntry('scenes', Astro.props.id);
if (!entry) throw new Error(`scenes: no entry ${Astro.props.id}`);
const names = await roleName();
const who = (s: string) => (s === 'human' ? 'You' : s === 'system' ? 'System' : names[s] ?? s);
---
<figure class="scene">
  <figcaption>{entry.data.title}</figcaption>
  <ol>
    {entry.data.lines.map((l) => (
      <li class={`line line--${l.kind}`}>
        <span class="who">{who(l.speaker)}{l.to && ` → ${l.to === 'all' ? 'everyone' : who(l.to)}`}</span>
        <span class="text">{l.text}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .scene { margin: 0; display: grid; gap: var(--space-2xs); }
  figcaption { font-weight: 600; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2xs); }
  .line { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr; gap: var(--space-s); }
  .who { color: var(--color-ink-muted); font-size: var(--step--1); }
  .line--command .text { font-family: var(--font-mono); }
  @media (max-width: 40rem) { .line { grid-template-columns: 1fr; gap: 0; } }
</style>
