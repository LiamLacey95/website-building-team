---
/**
 * The setup sentence on a white ticket (the marble's label), with a copy button. Accessible without JS: the
 * sentence is a selectable <code> with a "select and copy" hint; site.ts reveals the button and announces
 * the result in a live region.
 */
interface Props {
  sentence: string;
  /** site.setupIntro */
  label: string;
  /** site.gpuNotice: G1 Q7 D says it appears beside every setup block. */
  notice: string;
  id?: string;
}
const { sentence, label, notice, id = 'setup' } = Astro.props;
---
<div class="setup" data-copy-block>
  <p class="setup__label" id={`${id}-label`}>{label}</p>
  <div class="ticket setup__ticket">
    <span class="marble setup__marble" aria-hidden="true"></span>
    <code class="setup__sentence" id={`${id}-sentence`}>{sentence}</code>
    <button type="button" class="btn btn--strong setup__button" data-copy-target={`${id}-sentence`} aria-describedby={`${id}-label`} data-js-only>
      Copy
    </button>
  </div>
  <p class="setup__hint" data-no-js>Select the sentence and copy it.</p>
  <p class="setup__notice">{notice}</p>
  <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
</div>

<style>
  .setup { display: grid; gap: var(--space-3); max-width: 40rem; }
  .setup__label { font-weight: 700; }
  .setup__ticket { padding-inline-start: var(--space-4); }
  .setup__marble { font-size: 1.5rem; }
  .setup__sentence { flex: 1 1 14rem; font-weight: 600; font-size: var(--fs-sm); overflow-wrap: anywhere; user-select: all; }
  .setup__button { min-width: 6.5rem; }
  .setup__button[data-state='copied'] { background: var(--c-go); color: var(--c-text); }
  .setup__hint, .setup__notice { font-size: var(--fs-sm); font-weight: 700; }
  /* A pill only while the ticket stays on one line; wrapped, it becomes a rounded card. */
  @media (max-width: 40rem) { .setup__ticket { border-radius: var(--radius-lg); padding: var(--space-4); } .setup__button { flex: 1 1 100%; } }
</style>
