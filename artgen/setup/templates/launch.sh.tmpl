#!/usr/bin/env bash
# Website team art station (generated by artgen/setup/configure.py from team.config.json; do not edit).
# Engine + models: {{COMFYUI_PATH}}. Workflows, inputs, outputs: this folder. Open http://127.0.0.1:{{PORT}}
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "{{COMFYUI_PATH}}"
exec "{{COMFYUI_PYTHON}}" main.py --enable-manager --preview-method auto --listen 127.0.0.1 --port {{PORT}} \
  --user-directory "$HERE/user" --input-directory "$HERE/input" --output-directory "$HERE/output" \
  --extra-model-paths-config "$HERE/extra_model_paths.yaml"
