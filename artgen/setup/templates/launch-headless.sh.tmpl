#!/usr/bin/env bash
# Website team art station, headless (generated by artgen/setup/configure.py; do not edit).
# Server on http://127.0.0.1:{{PORT}}, log in artgen/user/comfyui_headless.log. Run in the background with:  nohup ./launch-comfyui-headless.sh &
# Usually you do not need this: artgen/generate.py starts and stops the server itself (or use generate.py --start / --stop).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$HERE/user"
cd "{{COMFYUI_PATH}}"
exec "{{COMFYUI_PYTHON}}" main.py --preview-method none --listen 127.0.0.1 --port {{PORT}} \
  --user-directory "$HERE/user" --input-directory "$HERE/input" --output-directory "$HERE/output" \
  --extra-model-paths-config "$HERE/extra_model_paths.yaml" > "$HERE/user/comfyui_headless.log" 2>&1
